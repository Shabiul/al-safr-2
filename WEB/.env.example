# Supabase project (Project Settings -> API / Database). Al Safr uses its own "alsafr" schema; create it with:
#   node scripts/db.mjs db/schema.sql
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Transaction pooler connection string (port 6543), with the database password filled in
DATABASE_URL=
# Signs CRM login cookies: 32+ random characters
AUTH_SECRET=
# First CRM login: signing in with these while no staff exist creates the owner (super admin) account
ADMIN_EMAIL=
ADMIN_PASSWORD=

